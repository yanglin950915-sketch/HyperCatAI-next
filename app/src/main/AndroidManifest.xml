<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:allowBackup="true" android:label="HyperCat AI" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:supportsRtl="true" android:theme="@style/Theme.HyperCat">
        <activity android:name=".rear.RearPetActivity" android:exported="true" android:excludeFromRecents="true" android:launchMode="singleTask" android:taskAffinity="" android:resizeableActivity="true" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <receiver android:name=".rear.RearProjectionCommandReceiver" android:exported="true">
            <intent-filter><action android:name="com.hypercat.ai.rear.ACTION_HIDE_PROJECTION" /></intent-filter>
        </receiver>
        <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="${applicationId}.shizuku" android:multiprocess="false" android:enabled="true" android:exported="true" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name=".MainActivity" android:theme="@style/Theme.HyperCat.Starting" android:exported="true" android:resizeableActivity="true" android:windowSoftInputMode="adjustResize" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service
            android:name=".HyperCatAccessibilityService"
            android:label="HyperCat AI 手机操作"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hypercat_accessibility_service" />
        </service>
        <receiver
            android:name=".rear.RearPetInteractionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hypercat.ai.rear.PET_INTERACTION" />
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rear_widget_file_paths" />
        </provider>
        <provider
            android:name=".rear.RearPetProvider"
            android:authorities="com.hypercat.ai.rear.provider"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
