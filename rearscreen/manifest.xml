<?xml version="1.0" encoding="UTF-8"?>
<Widget version="2" screenWidth="976" frameRate="30" scaleByDensity="false" transparentSurface="true" useVariableUpdater="DateTime.Second">
    <Var name="avatarUri" type="string" expression="'content://com.hypercat.ai.rear.provider/avatar-state'" const="true"/>
    <Var name="resultJson" type="string" expression="'{}'"/>
    <Var name="avatarName" type="string" expression="'小橘'"/>
    <Var name="avatarId" type="string" expression="'sakura'"/>
    <Var name="mood" type="string" expression="'normal'"/>
    <Var name="reply" type="string" expression="'你好！我是你的 AI 虚拟形象。'"/>
    <Var name="backgroundColor" type="string" expression="'#080B12'"/>
    <Var name="updatedAt" type="string" expression="'0'"/>
    <Var name="enabled" type="string" expression="'false'"/>
    <Var name="refreshTick" expression="#second">
        <Trigger>
            <BinderCommand name="avatarBinder" command="refresh"/>
        </Trigger>
    </Var>

    <VariableBinders>
        <ContentProviderBinder name="avatarBinder" uriExp="@avatarUri" columns="result">
            <Variable name="resultJson" column="result" type="string"/>
            <Trigger><FunctionCommand target="parseAvatar"/></Trigger>
        </ContentProviderBinder>
    </VariableBinders>

    <Function name="parseAvatar">
        <VariableCommand name="avatarName" expression="jsonGetString(strToJson(@resultJson), 'avatar_name')" type="string"/>
        <VariableCommand name="avatarId" expression="jsonGetString(strToJson(@resultJson), 'avatar_id')" type="string"/>
        <VariableCommand name="mood" expression="jsonGetString(strToJson(@resultJson), 'mood')" type="string"/>
        <VariableCommand name="reply" expression="jsonGetString(strToJson(@resultJson), 'reply')" type="string"/>
        <VariableCommand name="backgroundColor" expression="jsonGetString(strToJson(@resultJson), 'background_color')" type="string"/>
        <VariableCommand name="updatedAt" expression="jsonGetString(strToJson(@resultJson), 'updated_at')" type="string"/>
        <VariableCommand name="enabled" expression="jsonGetString(strToJson(@resultJson), 'enabled')" type="string"/>
        <WebViewCommand target="wv" command="runjs" params="'__setAgentJson('+@resultJson+')'" delay="250"/>
    </Function>

    <!-- Local offline Live2D renderer; content reserves the top-centre camera safe area. -->
    <WebView name="wv" x="0" y="0" w="#view_width" h="#view_height" local="true" cachePage="false" uri="web/live2d/render.html">
        <Triggers>
            <Trigger action="avatar_touch">
                <IntentCommand action="com.hypercat.ai.rear.AVATAR_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'avatar_touch'"/>
                </IntentCommand>
            </Trigger>
            <Trigger action="avatar_long_press">
                <IntentCommand action="com.hypercat.ai.rear.AVATAR_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'avatar_long_press'"/>
                </IntentCommand>
            </Trigger>
            <Trigger action="avatar_drag">
                <IntentCommand action="com.hypercat.ai.rear.AVATAR_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'avatar_drag'"/>
                </IntentCommand>
            </Trigger>
            <Trigger action="avatar_happy">
                <IntentCommand action="com.hypercat.ai.rear.AVATAR_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'avatar_happy'"/>
                </IntentCommand>
            </Trigger>
            <Trigger action="avatar_thinking">
                <IntentCommand action="com.hypercat.ai.rear.AVATAR_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'avatar_thinking'"/>
                </IntentCommand>
            </Trigger>
            <Trigger action="avatar_rest">
                <IntentCommand action="com.hypercat.ai.rear.AVATAR_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'avatar_rest'"/>
                </IntentCommand>
            </Trigger>
        </Triggers>
    </WebView>

    <ExternalCommands>
        <Trigger action="init">
            <WebViewCommand target="wv" command="runjs" params="'__fit();__setAod(0)'" delay="2000"/>
            <BinderCommand name="avatarBinder" command="refresh" delay="2100"/>
        </Trigger>
        <Trigger action="resume,exitAod">
            <WebViewCommand target="wv" command="runjs" params="'__fit();__setAod(0)'" delay="200"/>
            <BinderCommand name="avatarBinder" command="refresh" delay="250"/>
        </Trigger>
        <Trigger action="pause,enterAod">
            <WebViewCommand target="wv" command="runjs" params="'__setAod(1)'"/>
        </Trigger>
    </ExternalCommands>
</Widget>
