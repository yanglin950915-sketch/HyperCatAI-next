<?xml version="1.0" encoding="UTF-8"?>
<Widget version="2" screenWidth="976" frameRate="30" scaleByDensity="false" transparentSurface="true" useVariableUpdater="DateTime.Second">
    <Var name="petUri" type="string" expression="'content://com.hypercat.ai.rear.provider/pet-state'" const="true"/>
    <Var name="resultJson" type="string" expression="'{}'"/>
    <Var name="petName" type="string" expression="'小橘'"/>
    <Var name="petEmoji" type="string" expression="'🐱'"/>
    <Var name="mood" type="string" expression="'normal'"/>
    <Var name="reply" type="string" expression="'你好！我是你的 AI 虚拟形象。'"/>
    <Var name="updatedAt" type="string" expression="'0'"/>
    <Var name="enabled" type="string" expression="'false'"/>
    <Var name="refreshTick" expression="#second">
        <Trigger>
            <BinderCommand name="petBinder" command="refresh"/>
        </Trigger>
    </Var>

    <VariableBinders>
        <ContentProviderBinder name="petBinder" uriExp="@petUri" columns="result">
            <Variable name="resultJson" column="result" type="string"/>
            <Trigger><FunctionCommand target="parsePet"/></Trigger>
        </ContentProviderBinder>
    </VariableBinders>

    <Function name="parsePet">
        <VariableCommand name="petName" expression="jsonGetString(strToJson(@resultJson), 'pet_name')" type="string"/>
        <VariableCommand name="petEmoji" expression="jsonGetString(strToJson(@resultJson), 'pet_emoji')" type="string"/>
        <VariableCommand name="mood" expression="jsonGetString(strToJson(@resultJson), 'mood')" type="string"/>
        <VariableCommand name="reply" expression="jsonGetString(strToJson(@resultJson), 'reply')" type="string"/>
        <VariableCommand name="updatedAt" expression="jsonGetString(strToJson(@resultJson), 'updated_at')" type="string"/>
        <VariableCommand name="enabled" expression="jsonGetString(strToJson(@resultJson), 'enabled')" type="string"/>
    </Function>

    <!-- Local offline HTML renderer; content itself reserves the left camera exclusion zone. -->
    <WebView name="wv" x="0" y="0" w="#view_width" h="#view_height" local="true" cachePage="true" uri="web/index.html">
        <Triggers>
            <Trigger action="pet_touch">
                <IntentCommand action="com.hypercat.ai.rear.PET_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'pet_touch'"/>
                </IntentCommand>
            </Trigger>
            <Trigger action="pet_long_press">
                <IntentCommand action="com.hypercat.ai.rear.PET_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'pet_long_press'"/>
                </IntentCommand>
            </Trigger>
            <Trigger action="pet_happy">
                <IntentCommand action="com.hypercat.ai.rear.PET_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'pet_happy'"/>
                </IntentCommand>
            </Trigger>
            <Trigger action="pet_thinking">
                <IntentCommand action="com.hypercat.ai.rear.PET_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'pet_thinking'"/>
                </IntentCommand>
            </Trigger>
            <Trigger action="pet_rest">
                <IntentCommand action="com.hypercat.ai.rear.PET_INTERACTION" package="com.hypercat.ai" broadcast="true">
                    <Extra name="action" type="string" expression="'pet_rest'"/>
                </IntentCommand>
            </Trigger>
        </Triggers>
    </WebView>

    <ExternalCommands>
        <Trigger action="init">
            <WebViewCommand target="wv" command="runjs" params="'__fit();__setAod(0)'" delay="2000"/>
            <BinderCommand name="petBinder" command="refresh" delay="2100"/>
        </Trigger>
        <Trigger action="resume,exitAod">
            <WebViewCommand target="wv" command="runjs" params="'__fit();__setAod(0)'" delay="200"/>
            <BinderCommand name="petBinder" command="refresh" delay="250"/>
        </Trigger>
        <Trigger action="pause,enterAod">
            <WebViewCommand target="wv" command="runjs" params="'__setAod(1)'"/>
        </Trigger>
    </ExternalCommands>
</Widget>
